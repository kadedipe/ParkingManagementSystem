# ============================================================================
# Dockerfile - Nginx Web Server
# ============================================================================

# parking-management-system/infra/docker/Dockerfile.nginx

# Stage 1: Build custom Nginx with modules
FROM nginx:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    gcc \
    libc-dev \
    make \
    openssl-dev \
    pcre-dev \
    zlib-dev \
    linux-headers \
    curl \
    git \
    wget \
    build-base \
    libtool \
    automake \
    autoconf

# Download and build Nginx with additional modules
WORKDIR /tmp

# Download Nginx source
RUN wget https://nginx.org/download/nginx-1.25.3.tar.gz \
    && tar -xzf nginx-1.25.3.tar.gz \
    && rm nginx-1.25.3.tar.gz

# Clone additional modules
RUN git clone https://github.com/arut/nginx-rtmp-module.git \
    && git clone https://github.com/nginx/njs.git \
    && git clone https://github.com/opendeb/nginx_brotli.git

# Build Nginx with modules
WORKDIR /tmp/nginx-1.25.3

RUN ./configure \
    --prefix=/usr/share/nginx \
    --sbin-path=/usr/sbin/nginx \
    --modules-path=/usr/lib/nginx/modules \
    --conf-path=/etc/nginx/nginx.conf \
    --pid-path=/var/run/nginx.pid \
    --lock-path=/var/run/nginx.lock \
    --error-log-path=/var/log/nginx/error.log \
    --http-log-path=/var/log/nginx/access.log \
    --user=nginx \
    --group=nginx \
    --with-http_ssl_module \
    --with-http_v2_module \
    --with-http_realip_module \
    --with-http_addition_module \
    --with-http_sub_module \
    --with-http_dav_module \
    --with-http_flv_module \
    --with-http_mp4_module \
    --with-http_gunzip_module \
    --with-http_gzip_static_module \
    --with-http_auth_request_module \
    --with-http_random_index_module \
    --with-http_secure_link_module \
    --with-http_degradation_module \
    --with-http_slice_module \
    --with-http_stub_status_module \
    --with-http_perl_module \
    --with-perl_modules_path=/usr/share/perl5 \
    --with-perl=/usr/bin/perl \
    --with-mail \
    --with-mail_ssl_module \
    --with-stream \
    --with-stream_ssl_module \
    --with-stream_realip_module \
    --with-stream_ssl_preread_module \
    --add-module=/tmp/nginx-rtmp-module \
    --add-module=/tmp/njs/nginx \
    --add-module=/tmp/nginx_brotli

RUN make -j$(nproc) \
    && make install \
    && strip /usr/sbin/nginx

# Stage 2: Final Nginx image
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache \
    libcrypto3 \
    libssl3 \
    pcre2 \
    zlib \
    ca-certificates \
    tzdata \
    curl \
    wget \
    logrotate \
    shadow

# Create nginx user and group
RUN addgroup -g 101 -S nginx \
    && adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx nginx

# Create necessary directories
RUN mkdir -p /var/cache/nginx \
    && mkdir -p /var/log/nginx \
    && mkdir -p /etc/nginx/conf.d \
    && mkdir -p /etc/nginx/sites-enabled \
    && mkdir -p /etc/nginx/ssl \
    && mkdir -p /usr/share/nginx/html \
    && mkdir -p /var/www/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /etc/nginx \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/www/html

# Copy built Nginx from builder
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
COPY --from=builder /usr/lib/nginx/modules /usr/lib/nginx/modules
COPY --from=builder /usr/share/nginx /usr/share/nginx
COPY --from=builder /etc/nginx /etc/nginx

# Copy configuration files
COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/ /etc/nginx/conf.d/
COPY sites-enabled/ /etc/nginx/sites-enabled/
COPY nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
COPY health-check.sh /usr/local/bin/health-check.sh

# Make scripts executable
RUN chmod +x /usr/local/bin/nginx-entrypoint.sh \
    && chmod +x /usr/local/bin/health-check.sh

# Set up log rotation
COPY logrotate-nginx /etc/logrotate.d/nginx

# Expose ports
EXPOSE 80 443 1935

# Set environment variables
ENV NGINX_VERSION=1.25.3 \
    TZ=UTC

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/health-check.sh || exit 1

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/nginx-entrypoint.sh"]

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]