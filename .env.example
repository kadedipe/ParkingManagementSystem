# Shared production configuration (set these in Railway, never commit actual values)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/parking
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
