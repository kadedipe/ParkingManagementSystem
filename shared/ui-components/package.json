  },
  "bugs": {
    "url": "https://github.com/parkingapp/parking-system/issues"
  },
  "homepage": "https://github.com/parkingapp/parking-system#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}