{
  "name": "@parking-system/ui-components",
  "version": "2.0.0",
  "description": "Shared UI Components for Parking Management System",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:types && npm run build:js",
    "build:clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "npm run build:watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "storybook": "start-storybook -p 6006",
    "build:storybook": "build-storybook",
    "prepublishOnly": "npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-select": "^5.8.0",
    "react-spring": "^9.7.3",
    "framer-motion": "^10.16.16",
    "date-fns": "^2.30.0",
    "react-currency-input-field": "^3.6.11",
    "react-phone-number-input": "^3.3.11",
    "react-dropzone": "^14.2.3",
    "react-query": "^3.39.3",
    "react-table": "^7.8.0",
    "react-chartjs-2": "^5.2.0",
    "chart.js": "^4.4.1",
    "react-helmet-async": "^2.0.4",
    "react-icons": "^4.12.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "tailwind-merge": "^2.1.0",
    "lodash": "^4.17.21",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@storybook/addon-actions": "^7.6.7",
    "@storybook/addon-docs": "^7.6.7",
    "@storybook/addon-links": "^7.6.7",
    "@storybook/addon-essentials": "^7.6.7",
    "@storybook/react": "^7.6.7",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/react-table": "^7.7.19",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "rollup": "^4.9.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "storybook": "^7.6.7",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "sideEffects": false,
  "keywords": [
    "ui-components",
    "react",
    "typescript",
    "parking",
    "design-system"
  ],
  "author": "Parking Management Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parkingapp/parking-system.git",
