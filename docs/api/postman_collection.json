  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set default headers",
          "pm.request.headers.add({key: 'Accept', value: 'application/json'});",
          "pm.request.headers.add({key: 'Content-Type', value: 'application/json'});",
          "",
          "// Check if access token exists",
          "const accessToken = pm.variables.get('accessToken');",
          "if (accessToken && accessToken.length > 0) {",
          "    pm.request.headers.add({key: 'Authorization', value: 'Bearer ' + accessToken});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test response status",
          "pm.test('Status code is 2xx or 4xx', function () {",
          "    pm.response.to.be.success || pm.response.to.be.clientError;",
          "});",
          "",
          "// Check for authentication errors",
          "if (pm.response.code === 401) {",
          "    console.log('Authentication failed. Please login again.');",
          "    pm.variables.set('accessToken', '');",
          "}",
          "",
          "// Extract tokens from login response",
          "if (pm.response.code === 200) {",
          "    const response = pm.response.json();",
          "    if (response.data && response.data.tokens) {",
          "        pm.variables.set('accessToken', response.data.tokens.accessToken);",
          "        pm.variables.set('refreshToken', response.data.tokens.refreshToken);",
          "    }",
          "}"
        ]
      }
    }
  ]
}