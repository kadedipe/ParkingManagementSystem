<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     Debug Network Security Configuration
     ============================================================================ -->

<network-security-config>
    <!-- Allow cleartext traffic for debugging -->
    <base-config cleartextTrafficPermitted="true">
        <!-- Allow all certificates for debugging -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Domain-specific configurations -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
    </domain-config>

    <!-- Allow debug servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">debug.parking-system.com</domain>
        <domain includeSubdomains="true">staging.parking-system.com</domain>
    </domain-config>
</network-security-config>