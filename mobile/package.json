{
  "name": "parking-management-system-mobile",
  "version": "1.0.0",
  "description": "React Native mobile app for Parking Management System",
  "private": true,
  "author": "Parking Management System Team",
  "license": "MIT",
  "homepage": "https://parking-system.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/parking-management-system.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/parking-management-system/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "generate-icons": "node scripts/generate-android-icons.js",
    "generate-round-icons": "node scripts/generate-round-icons.js",
    "generate-icons": "node scripts/generate-all-icons.js",
    "generate-round-icons": "node scripts/generate-round-icons.js",
    "generate-all-icons": "node scripts/generate-all-icons.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "detox test",
    "test:e2e:ios": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "test:e2e:build": "detox build --configuration ios.sim.release",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
    "setup-gradle": "cd android && gradle wrapper --gradle-version 8.6",
    "generate-ios-icons": "node scripts/generate-ios-icons.js",
    "generate-launch-images": "node scripts/generate-launch-images.js",
    "generate-ios-assets": "npm run generate-ios-icons && npm run generate-launch-images",
    "generate-splash": "node scripts/generate-splash-screen.js",
    "generate-ios-assets": "npm run generate-ios-icons && npm run generate-splash",
    "generate-xcscheme": "node scripts/generate-xcscheme-management.js",
    "postinstall": "npm run generate-xcscheme",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules",
    "clean:ios": "cd ios && pod deintegrate && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "reset": "rm -rf node_modules && npm install",
    "reset:ios": "rm -rf node_modules && npm install && cd ios && pod install && cd ..",
    "reset:android": "rm -rf node_modules && npm install && cd android && ./gradlew clean && cd ..",
    "postinstall": "husky install",
    "pre-commit": "lint-staged",
    "build:ios:debug": "react-native run-ios --configuration Debug",
    "build:ios:release": "react-native run-ios --configuration Release",
    "build:ios:archive": "cd ios && xcodebuild -workspace ParkingSystem.xcworkspace -scheme ParkingSystem -configuration Release -archivePath build/ParkingSystem.xcarchive archive",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "distribute:ios": "fastlane ios beta",
    "distribute:android": "fastlane android beta"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.3",
    "@react-native-community/datetimepicker": "^7.6.0",
    "@react-native-community/geolocation": "^3.2.0",
    "@react-native-community/netinfo": "^9.3.10",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native-firebase/app": "^18.7.0",
    "@react-native-firebase/messaging": "^18.7.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.7",
    "date-fns": "^3.3.1",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-camera": "^4.2.1",
    "react-native-device-info": "^10.10.0",
    "react-native-document-picker": "^9.0.1",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-keychain": "^8.0.0",
    "react-native-maps": "^1.8.0",
    "react-native-paper": "^5.12.1",
    "react-native-permissions": "^3.10.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-webview": "^13.6.2",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/runtime": "^7.23.9",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.55",
    "@types/react-native": "^0.72.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "fastlane": "^2.214.0",
    "sharp": "^0.33.2",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.2.5",
    "react-native-dotenv": "^3.4.9",
    "react-native-testing-library": "^2.2.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react": "$react",
    "react-native": "$react-native"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-native": "0.73.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-vector-icons|react-native-paper|@react-native-async-storage|@reduxjs/toolkit|react-redux|redux-persist)/)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/jest.setup.js"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.[jt]sx?$"
  },
  "detox": {
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/ParkingSystem.app",
        "build": "xcodebuild -workspace ios/ParkingSystem.xcworkspace -scheme ParkingSystem -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15 Pro"
        }
      },
      "ios.sim.release": {
        "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/ParkingSystem.app",
        "build": "xcodebuild -workspace ios/ParkingSystem.xcworkspace -scheme ParkingSystem -configuration Release -sdk iphonesimulator -derivedDataPath ios/build",
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15 Pro"
        }
      },
      "android.emu.debug": {
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && cd ..",
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_5_API_33"
        }
      },
      "android.emu.release": {
        "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
        "build": "cd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release && cd ..",
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_5_API_33"
        }
      }
    }
  },
  "volta": {
    "node": "18.17.0",
    "npm": "10.2.5"
  }
}