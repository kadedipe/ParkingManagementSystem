{
  "name": "@parking/parking-service",
  "version": "1.0.0",
  "private": true,
  "description": "Parking Service - Microservice",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "babel src -d dist",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@parking/database": "workspace:*",
    "@parking/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  }
}