{
  "name": "parking-management-system-frontend",
  "version": "1.0.0",
  "description": "Modern React frontend for Parking Management System",
  "private": true,
  "type": "module",
  "engines": {"node": ">=18.0.0", "npm": ">=9.0.0"},
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite --debug",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "build:staging": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .vite node_modules/.vite",
    "clear": "rm -rf node_modules package-lock.json && npm install",
    "analyze": "vite build --mode analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate": "plop",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.js",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "docker:build": "docker build -t parking-frontend .",
    "docker:run": "docker run -p 5173:5173 parking-frontend"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@mui/x-data-grid": "^6.18.7",
    "@mui/x-date-pickers": "^6.18.7",
    "@tanstack/react-query": "^5.17.19",
    "@tanstack/react-query-devtools": "^5.17.19",
    "axios": "^1.6.7",
    "date-fns": "2.30.0",
    "formik": "^2.4.5",
    "jwt-decode": "^4.0.0",
    "lottie-react": "^2.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "react-hot-toast": "^2.4.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.10.3",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@cypress/code-coverage": "^4.0.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "cypress": "^15.20.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^9.0.10",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^23.2.0",
    "lint-staged": "^15.2.0",
    "plop": "^4.0.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "sass": "^1.70.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^1.2.2"
  },
  "overrides": {"react": "$react", "react-dom": "$react-dom"},
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{css,scss}": ["prettier --write"]
  },
  "volta": {"node": "18.17.0", "npm": "10.2.5"}
}
