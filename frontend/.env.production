# Public frontend build defaults. Railway should override deployment-specific URLs.
# No secrets belong in this file.
VITE_ENVIRONMENT=production
VITE_DEBUG=false
VITE_APP_NAME=Parking Management System
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Secure and scalable parking management platform
VITE_APP_URL=http://localhost:8080
VITE_API_URL=http://localhost:8000
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000
VITE_API_MAX_RETRIES=3
VITE_GOOGLE_ANALYTICS_ID=
VITE_ANALYTICS_ENABLED=false
VITE_PERFORMANCE_MONITORING_ENABLED=false
VITE_SERVICE_WORKER_ENABLED=false
VITE_SOURCE_MAPS_ENABLED=false
VITE_LOGGING_ENABLED=false
VITE_DEV_TOOLS_ENABLED=false
VITE_HMR_ENABLED=false
VITE_MOCK_API_ENABLED=false
VITE_CSP_PRODUCTION_ENABLED=true
VITE_CSP_DEVELOPMENT_ENABLED=false
